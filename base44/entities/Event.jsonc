{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "subheadline": {
      "type": "string",
      "description": "Short subheadline"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "image": {
      "type": "string",
      "description": "Event image URL"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "time": {
      "type": "string",
      "description": "Event time e.g. 19:00"
    },
    "category": {
      "type": "string",
      "enum": [
        "basketball",
        "concerts",
        "shows",
        "corporate",
        "other"
      ],
      "default": "other"
    },
    "available_suites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suite IDs available for this event"
    },
    "price": {
      "type": "string",
      "description": "Starting price label"
    },
    "cta_text": {
      "type": "string",
      "description": "CTA button text",
      "default": "Book Suite"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft"
      ],
      "default": "draft"
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}